    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
